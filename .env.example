# Public client configuration for the shared Supabase project.
# Never put service_role or other secret keys in this file or in the app.
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Optional HTTPS URL used for email confirmation links.
# If omitted, the current runtime origin is used.
VITE_PUBLIC_WEB_URL=https://your-web-domain.example

# Optional development-only remote URL for Capacitor.
# Leave unset for production so the app loads the bundled dist/ files.
# CAP_SERVER_URL=https://your-development-host.example
